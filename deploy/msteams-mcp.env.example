# Non-secret settings for msteams-mcp. Installed as /etc/msteams-mcp/msteams-mcp.env
# The MCP token, the vault key and the Microsoft refresh token are NOT here:
# the first two are TPM-sealed credentials, the refresh token is in the
# encrypted vault (see README).
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Must match a redirect URI registered on the app under
# "Mobile and desktop applications" (not Web, not SPA).
#MS_REDIRECT_URI=https://login.microsoftonline.com/common/oauth2/nativeclient

# Optional
#ENABLE_WRITE_TOOLS=true      # false = read-only: no send/reply/meeting tools
#KEEPALIVE_HOURS=12           # background refresh so the sign-in doesn't age out; 0 = off
#MAX_LIST_TEXT_CHARS=2000     # per-message text cut-off in list results
